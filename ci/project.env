# exported: the public lane's settings. The export installs this file
# as the public repository's ci/project.env, which ci/job.sh reads:
# comment lines and KEY="value" lines for known keys only.
BINARY="ecoesp"
BUILD="packaging/build.sh"
# PyInstaller on Linux needs objdump and objcopy, and strip for the
# spec's strip=True; the image has none of them.
APT_PACKAGES="binutils"
# The source keeps 'dev': a tag run stamps its tag into this file's
# __version__ line.
STAMP_FILE="ecoesp/__init__.py"
VERSION_PROBE="--version"
